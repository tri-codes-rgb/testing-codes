<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Single-Load Multi-Page Site</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <nav>
    <a href="#home">Home</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
  </nav>

  <main>
    <!-- Put your default landing page last in the HTML -->
    <section id="about" class="page">
      <h1>About Us</h1>
      <p>This loaded instantly without a page refresh.</p>
    </section>

    <section id="contact" class="page">
      <h1>Contact</h1>
      <p>Get in touch with us here.</p>
    </section>

    <section id="home" class="page">
      <h1>Welcome Home</h1>
      <p>This is the default page view.</p>
    </section>
  </main>

</body>
</html>
